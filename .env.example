# Environment Configuration for Question Paper Generator
# Copy this file to .env and modify as needed

# ---- LLM API Keys (choose one) ----
# Groq (FREE & FAST - recommended): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ---- LLM Provider: groq | openai ----
LLM_PROVIDER=groq

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLAMA_MODEL=meta-llama/Llama-3.1-8B-Instruct
GROQ_MODEL=llama3-8b-8192
OPENAI_MODEL=gpt-3.5-turbo

# Text Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Vector Store Settings
SIMILARITY_THRESHOLD=0.8
FAISS_INDEX_NAME=qpg_index

# Database Settings
DATABASE_NAME=qpg_database.db

# Application Settings
DEBUG=True
HOST=0.0.0.0
PORT=7860

# File Upload Settings
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt

# Question Generation Settings
DEFAULT_DIFFICULTY=Medium
DEFAULT_BLOOM_LEVEL=Apply
MAX_QUESTIONS_PER_PART=20

# PDF Generation Settings
PAGE_SIZE=A4
FONT_SIZE=11
MARGIN_SIZE=72